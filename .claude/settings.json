{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate.py\" session", "timeout": 60 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate.py\" pretool", "timeout": 20 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./kb list)",
      "Bash(./kb list *)",
      "Bash(./kb show *)",
      "Bash(./kb doctor)",
      "Bash(./kb doctor *)",
      "Bash(./kb fetch --list)",
      "Bash(python3 .claude/hooks/gate.py status)"
    ],
    "deny": [
      "Edit(/ashare-kb/sources/**/*.txt)",
      "Edit(/ashare-kb/sources/**/*.pdf)",
      "Edit(/ashare-kb/sources/**/*.html)",
      "Edit(/ashare-kb/sources/**/*.json)"
    ]
  }
}
