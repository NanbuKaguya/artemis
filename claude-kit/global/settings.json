{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python3 \"@KIT@/hooks/kit.py\" guard", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"@KIT@/hooks/kit.py\" snapshot", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "python3 \"@KIT@/hooks/kit.py\" format", "timeout": 40 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"@KIT@/hooks/kit.py\" stop", "timeout": 600 } ] }
    ]
  }
}
