# 复制为 .env 并填入。全部留空时 MVP 以"离线模板模式"运行（demo 可跑通）。

# —— LLM（任填其一即启用真实生成；留空=离线模板）——
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=

# —— 通知/人工闸门（飞书或企微机器人 Webhook；留空=仅控制台）——
FEISHU_WEBHOOK=
# WECOM_WEBHOOK=

# —— Memory 落盘路径（默认 data/memory.json）——
# MEMORY_PATH=

# —— 生产数据源（P2 起接入，付费第三方 API / 抖店开放平台）——
# CHANMAMA_TOKEN=
# DOUDIAN_APP_KEY=
# DOUDIAN_APP_SECRET=
