# ===== Artemis 运行配置 =====
# 复制为 /etc/artemis/artemis.env（或 ~/.config/artemis/artemis.env）后按实际修改

# --- 路径 ---
ARTEMIS_HOME=/opt/artemis
ARTEMIS_DATA_DIR=/var/lib/artemis/data_cache
ARTEMIS_JOURNAL=/var/lib/artemis/journal.jsonl
ARTEMIS_WATCHLIST=/var/lib/artemis/watchlist.txt
ARTEMIS_BRIEF_DIR=/var/lib/artemis/briefs

# --- 时区（关键）---
# 代码内部用 zoneinfo 强制 Asia/Shanghai，但日志时间戳走系统时区。
# 不设这个，你看日志会以为任务跑错了时间。
TZ=Asia/Shanghai

# --- 本地 Hermes ---
# Ollama    http://localhost:11434/v1
# vLLM      http://localhost:8000/v1
# LM Studio http://localhost:1234/v1
# llama.cpp http://localhost:8080/v1
ARTEMIS_LLM_BASE_URL=http://localhost:11434/v1
ARTEMIS_LLM_MODEL=hermes3
ARTEMIS_LLM_API_KEY=not-needed

# --- 可选：简报投递命令 ---
# 简报会以 stdin 传给它。留空则只写文件。
# 例：ARTEMIS_NOTIFY_CMD=/usr/local/bin/push-to-phone
ARTEMIS_NOTIFY_CMD=

# --- 调试 ---
# ARTEMIS_DEBUG=1   # 打开后错误返回里带 traceback
